le=\"width:200px; max-width:60%; height:auto; border:0; outline:none;\">\n  </td></tr>\n  <tr><td align=\"center\" style=\"padding:20px 30px 0 30px; font-family:'Gilroy',Arial,sans-serif; color:#e8b547; font-size:12px; font-weight:800; letter-spacing:1.4px; text-transform:uppercase;\">Invito</td></tr>\n  <tr><td align=\"center\" style=\"padding:10px 34px 0 34px;\">\n    <h2 style=\"margin:0; font-family:'Gilroy',Arial,sans-serif; font-size:26px; font-weight:800; line-height:1.25; color:#ffffff;\">{{ p144406271_dem_tracking.dem_v5_evento_nome }}</h2>\n  </td></tr>\n\n  {% if p144406271_dem_tracking.dem_v5_evento_featured_image %}\n  <tr><td style=\"padding:24px 30px 0 30px; line-height:0; font-size:0;\" align=\"center\">\n    <img src=\"{{ p144406271_dem_tracking.dem_v5_evento_featured_image }}\" alt=\"{{ p144406271_dem_tracking.dem_v5_evento_nome }}\" width=\"540\" style=\"display:block; width:100%; max-width:540px; height:auto; border-radius:12px; margin:0 auto;\">\n  </td></tr>\n  {% endif %}\n\n  <!-- scheda quando/dove -->\n  <tr><td style=\"padding:24px 30px 0 30px;\">\n    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"width:100%; border-collapse:separate; background-color:#0a5d61; border-radius:12px;\">\n      <tr>\n        <td width=\"50%\" align=\"center\" valign=\"top\" style=\"padding:16px 14px;\">\n          <div style=\"font-family:'Gilroy',Arial,sans-serif; font-size:11px; font-weight:800; letter-spacing:1.2px; text-transform:uppercase; color:#e8b547;\">Quando</div>\n          <div style=\"font-family:'Benton Sans Pro',Arial,sans-serif; font-size:16px; font-weight:bold; line-height:1.45; color:#ffffff; padding-top:6px;\">{{ p144406271_dem_tracking.dem_v5_evento_data_display }}{% if p144406271_dem_tracking.dem_v5_evento_orario_display %}<br>ore {{ p144406271_dem_tracking.dem_v5_evento_orario_display }}{% endif %}</div>\n        </td>\n        {% if venue_v|length > 0 or meeting_v|length > 0 %}\n        <td width=\"50%\" align=\"center\" valign=\"top\" style=\"padding:16px 14px;\">\n          <div style=\"font-family:'Gilroy',Arial,sans-serif; font-size:11px; font-weight:800; letter-spacing:1.2px; text-transform:uppercase; color:#e8b547;\">Dove</div>\n          <div style=\"font-family:'Benton Sans Pro',Arial,sans-serif; font-size:16px; font-weight:bold; line-height:1.45; color:#ffffff; padding-top:6px;\">{% if venue_v|length > 0 %}{{ venue_v }}{% else %}Online, in diretta{% endif %}</div>\n        </td>\n        {% endif %}\n      </tr>\n    </table>\n  </td></tr>\n\n  <!-- apertura -->\n  <tr><td align=\"center\" style=\"padding:24px 36px 0 36px;\">\n    <div style=\"font-family:'Benton Sans Pro',Arial,sans-serif; font-size:16px; line-height:1.6; color:#eaf3f3;\">Gentile{% if contact.firstname %} {{ contact.firstname }}{% endif %}, c'&egrave; un posto riservato per lei. Partecipare &egrave; gratuito e bastano pochi secondi per iscriversi.</div>\n  </td></tr>\n\n  {% if p144406271_dem_tracking.dem_v5_landing_url %}\n  <tr><td align=\"center\" style=\"padding:24px 30px 36px 30px;\">\n    <table role=\"presentation\" align=\"center\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:0 auto;\">\n      <tr><td align=\"center\" bgcolor=\"#e8b547\" style=\"background-color:#e8b547; border-radius:999px;\">\n        <a href=\"{{ p144406271_dem_tracking.dem_v5_landing_url }}\" style=\"background-color:#e8b547; color:#06484b; padding:15px 38px; text-decoration:none; font-size:15px; font-weight:bold; border-radius:999px; display:inline-block; text-transform:uppercase; letter-spacing:0.6px; font-family:'Gilroy',Arial,sans-serif;\"><font color=\"#06484b\">Riservo il posto</font></a>\n      </td></tr>\n    </table>\n  </td></tr>\n  {% else %}\n  <tr><td style=\"padding:0 0 36px 0;\">&nbsp;</td></tr>\n  {% endif %}\n</table>\n\n<!-- ============ 2. BLOCCO CHIARO: di cosa parliamo ============ -->\n{% if p144406271_dem_tracking.dem_v5_evento_page_body %}\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"width:100%; border-collapse:separate; background-color:#FFFFFF; border-radius:16px; margin:16px 0 0 0;\">\n  <tr><td style=\"padding:30px 32px 10px 32px;\">\n    <div style=\"font-family:'Gilroy',Arial,sans-serif; font-size:12px; font-weight:800; letter-spacing:1.2px; text-transform:uppercase; color:#448285;\">Di cosa parliamo</div>\n  </td></tr>\n  <tr><td style=\"padding:0 32px 30px 32px;\">\n    <div style=\"font-family:'Benton Sans Pro',Arial,sans-serif; color:#1a1a1a; font-size:15px; line-height:1.62;\">{{ p144406271_dem_tracking.dem_v5_evento_page_body|regex_replace(\"background(-color)?\\\\s*:\\\\s*[^;]+;?\", \"\")|render }}</div>\n  </td></tr>\n</table>\n{% endif %}\n\n<!-- ============ 3. CHIUSURA PETROLIO: seconda occasione di iscriversi ============ -->\n{% if p144406271_dem_tracking.dem_v5_landing_url %}\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"width:100%; border-collapse:separate; background-color:#05484C; border-radius:16px; margin:16px 0 0 0;\">\n  <tr><td align=\"center\" style=\"padding:30px 34px 0 34px;\">\n    <div style=\"font-family:'Gilroy',Arial,sans-serif; font-size:21px; font-weight:800; line-height:1.3; color:#ffffff;\">Ci vediamo {{ p144406271_dem_tracking.dem_v5_evento_data_display }}</div>\n  </td></tr>\n  <tr><td align=\"center\" style=\"padding:12px 36px 0 36px;\">\n    <div style=\"font-family:'Benton Sans Pro',Arial,sans-serif; font-size:15px; line-height:1.6; color:#dfeeec;\">L'iscrizione &egrave; gratuita e dura pochi secondi. Se non riuscir&agrave; a collegarsi, le invieremo comunque la registrazione.</div>\n  </td></tr>\n  <tr><td align=\"center\" style=\"padding:22px 30px 30px 30px;\">\n    <table role=\"presentation\" align=\"center\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:0 auto;\">\n      <tr><td align=\"center\" bgcolor=\"#e8b547\" style=\"background-color:#e8b547; border-radius:999px;\">\n        <a href=\"{{ p144406271_dem_tracking.dem_v5_landing_url }}\" style=\"background-color:#e8b547; color:#06484b; padding:15px 38px; text-decoration:none; font-size:15px; font-weight:bold; border-radius:999px; display:inline-block; text-transform:uppercase; letter-spacing:0.6px; font-family:'Gilroy',Arial,sans-serif;\"><font color=\"#06484b\">Iscrivimi all'evento</font></a>\n      </td></tr>\n    </table>\n  </td></tr>\n</table>\n{% endif %}\n\n<!-- ============ 4. CHI SIAMO, in fondo e piccolo ============ -->\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"width:100%; border-collapse:separate; margin:16px 0 0 0;\">\n  <tr><td align=\"center\" style=\"padding:6px 34px 0 34px;\">\n    <div style=\"font-family:'Benton Sans Pro',Arial,sans-serif; font-size:12.5px; line-height:1.6; color:#6a7a82;\">Spaggiari &egrave; al fianco della scuola dal 1926, con software e servizi per la didattica, la segreteria e le famiglie.</div>\n  </td></tr>\n</table>\n", "module_id": 1155639}, "child_css": {}, "css": {}, "id": "module_17787858993112", "label": null, "module_id": 1155639, "name": "module_17787858993112", "order": 3, "smart_type": null, "styles": {}, "type": "module"}, "module_17801660893974": {"body": {"css_class": "dnd-module", "hs_enable_module_padding": true, "hs_wrapper_css": {"padding-bottom": "18px", "padding-left": "20px", "padding-right": "20px", "padding-top": "14px"}, "html": "<p style=\"margin:0;text-align:center;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:18px;color:#666666;\">Dal 1926 al fianco della scuola. &nbsp;|&nbsp; <a href=\"{{ view_as_page_url }}\" style=\"color:#1a1a1a;text-decoration:underline;\">Vedi online</a></p>", "path": "@hubspot/rich_text", "schema_version": 2}, "child_css": {}, "css": {}, "id": "module_17801660893974", "label": null, "module_id": 1155639, "name": "module_17801660893974", "order": 1, "smart_type": null, "s